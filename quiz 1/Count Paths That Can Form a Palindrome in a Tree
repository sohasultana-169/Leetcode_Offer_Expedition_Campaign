class Solution {
public:
    long long countPalindromePaths(vector<int>& parent, string s) {
        int n = parent.size();
        vector<vector<pair<int,int>>> adj(n);

        for (int i = 1; i < n; i++) {
            int p = parent[i];
            int mask = 1 << (s[i] - 'a');
            adj[p].push_back({i, mask});
            adj[i].push_back({p, mask});
        }

        unordered_map<int, long long> mp;
        long long ans = 0;

        function<void(int,int,int)> dfs = [&](int node, int par, int mask) {
            ans += mp[mask];
            for (int i = 0; i < 26; i++) {
                ans += mp[mask ^ (1 << i)];
            }

            mp[mask]++;

            for (auto &[nei, m] : adj[node]) {
                if (nei == par) continue;
                dfs(nei, node, mask ^ m);
            }
        };

        dfs(0, -1, 0);

        return ans;
    }
};
