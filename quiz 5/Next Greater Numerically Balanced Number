class Solution {
public:
    bool isBalanced(int x) {
        vector<int> cnt(10, 0);
        int temp = x;

        while (temp) {
            cnt[temp % 10]++;
            temp /= 10;
        }

        for (int d = 0; d <= 9; d++) {
            if (cnt[d] > 0 && cnt[d] != d) return false;
        }

        return true;
    }

    int nextBeautifulNumber(int n) {
        int x = n + 1;
        while (true) {
            if (isBalanced(x)) return x;
            x++;
        }
    }
};
