class Solution {
public:
    int numWays(int steps, int arrLen) {
        const int MOD = 1e9 + 7;
        int maxPos = min(arrLen - 1, steps);
        
        vector<long long> dp(maxPos + 1, 0), next(maxPos + 1, 0);
        dp[0] = 1;

        for (int s = 1; s <= steps; s++) {
            fill(next.begin(), next.end(), 0);
            for (int i = 0; i <= maxPos; i++) {
                next[i] = dp[i];
                if (i - 1 >= 0) next[i] = (next[i] + dp[i - 1]) % MOD;
                if (i + 1 <= maxPos) next[i] = (next[i] + dp[i + 1]) % MOD;
            }
            dp = next;
        }

        return dp[0];
    }
};
