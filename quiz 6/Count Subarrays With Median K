class Solution {
public:
    int countSubarrays(vector<int>& nums, int k) {
        int n = nums.size();
        int idx = find(nums.begin(), nums.end(), k) - nums.begin();
        
        unordered_map<int, int> mp;
        mp[0] = 1;
        
        int balance = 0;
        for (int i = idx - 1; i >= 0; i--) {
            if (nums[i] < k) balance--;
            else balance++;
            mp[balance]++;
        }
        
        int ans = 0;
        balance = 0;
        for (int i = idx; i < n; i++) {
            if (nums[i] < k) balance--;
            else if (nums[i] > k) balance++;
            
            ans += mp[-balance] + mp[-balance + 1];
        }
        
        return ans;
    }
};
