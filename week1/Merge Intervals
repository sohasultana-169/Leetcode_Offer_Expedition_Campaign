class Solution { 
public:
    vector<vector<int>> merge(vector<vector<int>>& intervals) {
        if (intervals.size() == 1) return intervals;

        sort(intervals.begin(), intervals.end()); // FIX

        vector<vector<int>> result;
        stack<vector<int>> st;

        st.push(intervals[0]);

        for (int i = 1; i < intervals.size(); ++i) {
            auto temp = st.top();

            if (intervals[i][0] <= temp[1]) {
                int t1 = temp[0];
                int t2 = max(temp[1], intervals[i][1]);

                st.pop();
                st.push({t1, t2});
            } else {
                st.push(intervals[i]);
            }
        }

        while (!st.empty()) {
            result.push_back(st.top());
            st.pop();
        }

        reverse(result.begin(), result.end()); // optional (to maintain order)
        return result;
    }
};
