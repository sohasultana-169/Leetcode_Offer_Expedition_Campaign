class Solution {
public:
    void bfs(vector<vector<char>> &grid, vector<vector<bool>> &visited, int i, int j) {
        int m = grid.size();
        int n = grid[0].size();

        queue<pair<int,int>> q;
        q.push({i, j});
        visited[i][j] = true;

        vector<int> dx = {1, -1, 0, 0};
        vector<int> dy = {0, 0, 1, -1};

        while (!q.empty()) {
            auto [r, c] = q.front();
            q.pop();

            for (int k = 0; k < 4; ++k) {
                int x = r + dx[k];
                int y = c + dy[k];

                if (x >= 0 && y >= 0 && x < m && y < n &&
                    grid[x][y] == '1' && !visited[x][y]) {
                    q.push({x, y});
                    visited[x][y] = true;
                }
            }
        }
    }

    int numIslands(vector<vector<char>>& grid) {
        int m = grid.size();
        int n = grid[0].size();

        vector<vector<bool>> visited(m, vector<bool>(n, false));
        int result = 0;

        for (int i = 0; i < m; ++i) {
            for (int j = 0; j < n; ++j) {
                if (!visited[i][j] && grid[i][j] == '1') {
                    bfs(grid, visited, i, j);
                    result++;
                }
            }
        }

        return result;
    }
};
