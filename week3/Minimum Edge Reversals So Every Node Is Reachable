class Solution {
public:
    vector<vector<pair<int,int>>> adj;
    vector<int> ans;

    void dfs1(int node, int parent, int &count) {
        for (auto &[nei, cost] : adj[node]) {
            if (nei == parent) continue;
            if (cost == 1) count++;
            dfs1(nei, node, count);
        }
    }

    void dfs2(int node, int parent) {
        for (auto &[nei, cost] : adj[node]) {
            if (nei == parent) continue;
            if (cost == 0) ans[nei] = ans[node] + 1;
            else ans[nei] = ans[node] - 1;
            dfs2(nei, node);
        }
    }

    vector<int> minEdgeReversals(int n, vector<vector<int>>& edges) {
        adj.resize(n);
        ans.resize(n);

        for (auto &e : edges) {
            int u = e[0], v = e[1];
            adj[u].push_back({v, 0});
            adj[v].push_back({u, 1});
        }

        int count = 0;
        dfs1(0, -1, count);
        ans[0] = count;

        dfs2(0, -1);

        return ans;
    }
};
